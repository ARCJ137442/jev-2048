# 依赖
node_modules/

# 编译产物（由 ./start.sh 生成，不入库）
dist/
dist-test/
public/js/

# 密钥 —— 绝不能进仓库
../local/vercel-secret-api-key
local/
*.key
*.sealed
openrouter-secret-api-key*

# git 自身的目录 —— 绝不能被提交
# 真实教训：.git.backup 曾不在忽略列表里，一次 git add -A 把整个旧 .git
# 提交了进去。里面的对象是 zlib 压缩的，明文正则扫描**抓不到**，
# 但任何人解压就能还原出密钥。
.git/
.git.backup/
.git*/
*.pack
*.idx

# 本地验证时的克隆残留
clone-check/
*-check/

# 编辑器 / 系统
.DS_Store
.vscode/
.idea/
*.log
